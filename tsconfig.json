{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"],
    "rootDir": "src",
    "outDir": "build",
    "allowJs": false,
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noCheck": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "src/background.ts",
    "src/content-script.ts",
    "src/popup.ts",
    "src/onboarding.ts"
  ]
}
